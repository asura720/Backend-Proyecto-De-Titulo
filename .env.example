# Copia este archivo a ".env" en el servidor y cambia los valores.
# El docker-compose.aws.yml lee estas variables automáticamente.
#   cp .env.example .env && nano .env

# Contraseña del usuario root de MySQL (pon una segura, sin comillas)
DB_PASSWORD=cuidapp_root_2026_cambia_esto

# Secreto para firmar los JWT (debe ser largo). Debe ser el MISMO valor
# que use el gateway y el servicio de autenticación (aquí ya es compartido).
JWT_SECRET=PON_UN_SECRETO_LARGO_Y_UNICO_AQUI

